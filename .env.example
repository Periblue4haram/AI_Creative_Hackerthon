# 이 파일을 복사해 .env를 만들고 값을 채운다.
# .env에는 실제 키가 들어가므로 Git에 올리지 않는다. 이 파일에는 실제 값을 넣지 않는다.

# ---------- 서버 ----------
SERVER_PORT=8080
# 프론트엔드 주소. 여러 개면 쉼표로 구분
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ---------- MySQL ----------
DB_URL=jdbc:mysql://localhost:3306/ai_diary?serverTimezone=Asia/Seoul&characterEncoding=UTF-8
DB_USERNAME=
DB_PASSWORD=

# ---------- 서버 내부 비밀값 ----------
# 각각 다른 값을 쓴다. 32바이트 이상의 임의 값
JWT_SECRET=
# 이미지 서명 URL용
IMAGE_URL_SIGNING_SECRET=
# 이메일 인증 코드 해시용
EMAIL_CODE_HMAC_SECRET=

# ---------- 이미지 저장소 ----------
# 웹에서 바로 열리지 않고 재배포해도 지워지지 않는 폴더
IMAGE_STORAGE_ROOT=./data/images

# ---------- Gemini ----------
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
# 대화와 일기 글 생성. 사진 입력을 지원하는 모델
GEMINI_CHAT_MODEL=gemini-3.5-flash
# 검색 임베딩. 모델이나 차원을 바꾸면 기존 임베딩을 다시 만들어야 한다
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
GEMINI_EMBEDDING_DIMENSIONS=768

# 이 값보다 유사도가 낮은 검색 결과는 제외한다. 실제 데이터로 조정한다
SEARCH_MIN_SIMILARITY=0.6

# ---------- Cloudflare Workers AI (그림체 변환) ----------
# 대시보드의 계정 ID와, Workers AI 읽기/편집 권한이 있는 API 토큰
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_IMAGE_MODEL=@cf/black-forest-labs/flux-2-klein-4b

# ---------- 네이버 클라우드 Maps (Reverse Geocoding) ----------
# 콘솔에서 Application을 등록할 때 Reverse Geocoding을 선택한다
NAVER_MAPS_CLIENT_ID=
NAVER_MAPS_CLIENT_SECRET=

# ---------- 구글 로그인 ----------
# 프론트엔드와 같은 웹 클라이언트 ID. ID 토큰 검증에 쓰며 시크릿은 필요 없다
GOOGLE_CLIENT_ID=

# ---------- 인증 메일 (SMTP) ----------
# 아래 기본값은 Gmail 기준. 비밀번호는 Google 앱 비밀번호를 쓴다
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
